# 複製這個檔案為 .env 並填入你的金鑰
# 取得 Gemini API 金鑰：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 多把金鑰輪替（選填，優先於 GEMINI_API_KEY）：逗號分隔，
# 免費層每天每把 key 只有少量請求，撞到 429 會自動換下一把
# GEMINI_API_KEYS=key1,key2,key3

# LLM 型號（gemini-2.5-flash 對新帳號已停用；分析用 gemini-flash-lite-latest 即可，
# 展演前想更準可換 gemini-3.5-flash）
GEMINI_MODEL=gemini-3.5-flash

# 轉錄後端：
#   local  = 本地 faster-whisper（需 NVIDIA GPU，本機開發用這個）
#   gemini = 用 Gemini 直接聽音訊轉錄（雲端無 GPU 時用；Dockerfile 已預設 gemini）
TRANSCRIBE_ENGINE=local

# Gemini 轉錄專用模型（只在 TRANSCRIBE_ENGINE=gemini 時有作用）。
# 轉錄吃掉絕大多數請求（即時聆聽每段一次）但不需要聰明模型，預設用
# 免費額度高的輕量版；分析仍走上面的 GEMINI_MODEL，品質不受影響
# TRANSCRIBE_MODEL=gemini-flash-lite-latest

# 強模型（講者分辨較好）。預設不啟用：它每日只有 20 次，且實測連打 5 次會中
# 一次 503，而長檔是「整份一次大呼叫」，撞上就整份失敗、白等十分鐘。
# 長檔預設一律走 lite 分段（下面的門檻預設 0）。
TRANSCRIBE_FALLBACK_MODEL=gemini-3.5-flash
#
# 超過幾秒的檔案改用上面的強模型整份單次轉錄。0＝停用（預設），一律 lite 分段。
# 額度充裕或升級付費、且在意多人講者分辨時，設 600（10 分鐘）換回。
# TRANSCRIBE_LONG_FILE_THRESHOLD_SECONDS=0
#
# 多人會議的講者分辨：實測 flash-lite 對「誰在講話」的辨識不穩定，多位講者
# 常被併成一兩位。若你的錄音常有 3 人以上、需要準確標出講者，改用較強的
# 模型（免費每日額度較低）：
# TRANSCRIBE_MODEL=gemini-3.5-flash

# Whisper 模型與裝置（只在 TRANSCRIBE_ENGINE=local 時有作用）。
# 留空 = 自動：有 CUDA 用 GPU+medium，否則 CPU+small
# 可選模型：tiny / base / small / medium / large-v3
WHISPER_MODEL=
WHISPER_DEVICE=

# 即時聆聽每段錄音的秒數（30~60 建議值）
LIVE_CHUNK_SECONDS=45

# 預錄聲音辨識人（選用功能）：會前每人錄一小段，結束分析時用聲紋把逐字稿的
# 「講者A/B/C」換成真實姓名。最多幾個人可以錄樣本；設 0 則整個功能停用、
# 前端連入口都不顯示。使用者沒勾選就完全不會用到，不產生任何額外請求。
LIVE_ENROLL_MAX_SPEAKERS=4
# 聲紋比對的模型。一場會議只打一次（相較轉錄每 45 秒一次），所以用強模型換
# 準確度很划算——比對嗓音比轉錄吃力，lite 實測容易亂猜。空＝沿用 CORRECT_MODEL
VOICE_MATCH_MODEL=gemini-3.5-flash

# 聲紋跨段接力（預設開，封頂 20 位）：長檔切段轉錄時，每段轉完替新出現的講者
# 代號剪一小截嗓音，接力餵給後續分段當參考音訊，讓模型靠嗓音沿用同一代號，而
# 不是靠純文字提示憑空猜。只影響長檔分段轉錄，即時聆聽不經過這條路。
# 代價：每段都要重傳全部樣本（重試也會重傳），一支 77 分鐘的檔約多 240~400 次
# 上傳往返、多花數分鐘。趕時間或額度吃緊就設 0 關掉。
# VOICE_RELAY_MAX_SPEAKERS=20

# 專門的講者分離（選填）：用 pyannoteAI 聲學模型對整份音檔分群，再依時間戳重標
# Gemini 逐字稿的講者（77 分鐘協商實測：Gemini lite 只分出 3 位、pyannote 分出 19 位）。
# 預錄聲音辨識人也改用 voiceprint 比對。只在 TRANSCRIBE_ENGINE=gemini 時生效；
# 設了之後聲紋接力自動跳過。不填＝照舊由 Gemini 標講者，失敗也會自動退回。
# 金鑰：https://www.pyannote.ai（需公司或學校信箱；試用 30 天含 150 小時、10 個 voiceprint）
# 啟用後會議音訊與聲音樣本會上傳到 pyannoteAI 暫存處理（24~48 小時內自動刪除）
# PYANNOTE_API_KEY=
# PYANNOTE_MODEL=precision-2
# DIARIZE_TIMEOUT_SECONDS=900
# 聲紋比對門檻 0~100（實測本人 89 分、非本人 16~28 分）
# VOICEPRINT_MATCH_THRESHOLD=50

# 後臺資料庫（選填）：兩者都不填 = 本地 JSON（data/output/db.json，重啟會清空）；
# 填任一個就改用 Firebase Firestore 雲端持久化。取得金鑰：Firebase Console
# → 專案設定 → 服務帳戶 → 產生新的私密金鑰（下載 service account JSON）。
#   本機：指向下載的 JSON 檔路徑
# FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
#   雲端（如 Render）：把整份 JSON 內容貼成單行字串
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# API 認證（強烈建議部署到公開網址時設定）：設了才會要求所有 /api/* 請求
# 帶 Authorization: Bearer <token>，否則任何人拿到網址就能讀寫/刪除全部資料。
# 本機開發留空 = 不驗證。前端第一次收到 401 會跳出輸入框，輸入後存在瀏覽器 localStorage。
# API_TOKEN=換成一串隨機字串（例如 openssl rand -hex 32）

# 單次上傳的大小上限（MB，預設 500）。免費層雲端只有幾百 MB 的暫時性磁碟，
# 寫爆之後連 db.json 都存不進去；磁碟更小的方案就往下調
MAX_UPLOAD_MB=500

# 速率限制：每位使用者、每種耗額度的操作有每分鐘／每天上限，超過回 429。
# 部署在 Render 時自動開啟、本機開發預設關閉；要強制開關就設 1 或 0
# RATE_LIMIT_ENABLED=
# 覆寫個別上限（每分鐘/每天，0＝不限），沒寫到的沿用預設。可用名稱：
# analyze（10/60）、media（3/20）、live_start（3/20）、live_chunk（20/600）、ask（10/100）、translate（20/300）
# RATE_LIMITS=media=5/30,ask=20/200

# Google 登入（選填）：填了這組就啟用真正的帳號制——每個人用自己的 Google 帳號
# 登入，歷史會議、任務、詞彙表、講者名冊、跨會議問答全部依帳號分開。不填＝
# 單人模式（所有人共用同一份資料，靠上面的 API_TOKEN 決定進不進得來）。
# 三個值都在 Firebase Console →「專案設定 → 一般設定 → 你的應用程式」拿得到，
# 都是公開值（安全性靠後端驗簽，不靠把 apiKey 藏起來）。
# 注意：啟用登入一定要同時設 FIREBASE_CREDENTIALS_JSON 或 _FILE，
# 驗證 ID token 需要 service account 金鑰；少了會直接啟動失敗。
# FIREBASE_WEB_API_KEY=AIza...
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project

# 公開部署卻不要任何認證（預設不啟用）。偵測到跑在 Render 上（RENDER=true）
# 而上面兩種把關方式一個都沒設時，服務會直接啟動失敗——因為「照常起來」看
# 起來一切正常，卻是全世界都能讀寫刪除你的資料，沒有任何徵兆。
# 真的想開一個沒有門的公開站，設 1 明講。本機開發不受影響，不必設。
# ALLOW_NO_AUTH=1
